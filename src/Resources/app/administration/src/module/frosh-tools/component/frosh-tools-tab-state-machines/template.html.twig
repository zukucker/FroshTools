<div class="ft frosh-tab-sm">
    <ft-page-head
        :title="$t('frosh-tools.tabs.state-machines.title')"
        subtitle="Visualize states, transitions and actions for any registered state machine."
    />
    <sw-single-select
        v-model:value="selectedStateMachine"
        :options="stateMachineOptions"
        :aside="true"
        :disable-search-function="true"
        @update:value="onStateMachineChange"
        :placeholder="$t('frosh-tools.chooseStateMachine')"
    />

    <div class="state-machine-explorer" v-if="selectedStateMachine">
        <ft-panel title='States'>
            <mt-text-field placeholder="State suchen..." />
            <div class="state" v-for="state in states">
                {{state.name}}
            </div>

        </ft-panel>

        <ft-panel title="State">
            <div><b>Beschreibung</b></div>
            <p>Startzustand einer neuen order Transaction</p>

            <div><b>Eingehende Transitionen(2)</b></div>
            <div class="incoming-transitions">
                <div class="transition">
                    <div>reopen</div>
                    <span>von Reminded</span>
                </div>
                <div class="transition">
                    <div>process_unconfirmed</div>
                    <span>von: Unconfirmed</span>
                </div>
            </div>
            <div><b>Ausgehende Transitionen(5)</b></div>
            <div class="outgoing-transitions">
                <div class="transition">
                    <div>pay</div>
                    <span>Paid</span>
                </div>
                <div class="transition">
                    <div>cancel</div>
                    <span>Canceled</span>
                </div>
                <div class="transition">
                    <div>fail</div>
                    <span>Failed</span>
                </div>
                <div class="transition">
                    <div>process</div>
                    <span>In Progress</span>
                </div>
                <div class="transition">
                    <div>remind</div>
                    <span>Reminded</span>
                </div>
            </div>

        </ft-panel>

        <ft-panel title="Graph">

        </ft-panel>
    </div>
    {#<ft-panel :title="$t('frosh-tools.tabs.state-machines.label')">#}
        {#<template #actions>#}
            {#<div class="frosh-tab-sm__select">#}
                {#<sw-single-select#}
                    {#v-model:value="selectedStateMachine"#}
                    {#:options="stateMachineOptions"#}
                    {#:aside="true"#}
                    {#:disable-search-function="true"#}
                    {#@update:value="onStateMachineChange"#}
                    {#:placeholder="$t('frosh-tools.chooseStateMachine')"#}
                {#/>#}
            {#</div>#}
        {#</template>#}
        {#<div class="frosh-tab-sm__body">#}
            {#Test#}
        {#</div>#}
        {#[><div class="frosh-tab-sm__body"><]#}
            {#[><ft-empty<]#}
                {#[>v-if="!selectedStateMachine"<]#}
                {#[>icon="flow"<]#}
                {#[>title="No state machine selected"<]#}
                {#[>sub="Pick one from the dropdown above to render its diagram."<]#}
            {#[>/><]#}
            {#[><div id="states"><]#}
                {#[><div v-for="state in states"><]#}
                {#[>{{state.name}}<]#}
                {#[></div><]#}
            {#[></div><]#}
            {#[>[><div<]<]#}
                {#[>[>id="state_machine"<]<]#}
                {#[>[>class="frosh-tab-sm__canvas"<]<]#}
                {#[>[>v-show="selectedStateMachine"<]<]#}
            {#[>[>></div><]<]#}
        {#[></div><]#}
    {#</ft-panel>#}
</div>
